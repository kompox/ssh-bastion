#!/bin/sh

# Restricted login shell for the SSH bastion user.
#
# This script is used as the user's login shell to prevent interactive access
# and to avoid executing arbitrary commands.
#
# Notes:
# - It prints a short, human-readable status block and exits.
# - `SSH_ORIGINAL_COMMAND` (when present) is the remote command string requested
#   by the SSH client (e.g. `ssh jump@host <command>`). It is a raw string and
#   is shown for diagnostics only (never executed).
# - `SSH_CONNECTION` (when present) contains client/server addresses and ports.

cat <<EOF
This is Kompox SSH Bastion.  Use ssh -J / ProxyJump.
User:       ${LOGNAME:-${USER:-jump}}
Connection: ${SSH_CONNECTION:-<none>}
Command:    ${SSH_ORIGINAL_COMMAND:-<none>}
EOF
